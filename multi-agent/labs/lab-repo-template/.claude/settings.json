{
  "permissions": {
    "allow": [
      "Bash(python -m unittest *)",
      "Bash(python -m unittest)",
      "Bash(python -m vibelab.run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./data/**)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "env": {
    "PYTHONPATH": "src"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/guard_bash.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/run_tests.py" }
        ]
      }
    ]
  }
}
